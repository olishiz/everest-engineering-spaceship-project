        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt; &amp;nbsp; &lt;font color=&quot;#2563eb&quot;&gt;■ DTO / API input&lt;/font&gt; &amp;nbsp; &lt;font color=&quot;#059669&quot;&gt;■ TypeORM entity&lt;/font&gt; &amp;nbsp; &lt;font color=&quot;#ea580c&quot;&gt;■ PostgreSQL&lt;/font&gt; &amp;nbsp; dashed = maps/uses &amp;nbsp; solid = persists &amp;nbsp; crow's foot = FK cardinality" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontSize=15;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1460" y="28" width="800" height="62" as="geometry"/>
        </mxCell>

        <mxCell id="lane-dto" value="API CONTRACTS / VALIDATION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=17;fontStyle=1;fontColor=#1e3a8a;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="115" width="640" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="lane-entity" value="APPLICATION / TYPEORM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#059669;fontSize=17;fontStyle=1;fontColor=#064e3b;align=center;" vertex="1" parent="1">
          <mxGeometry x="740" y="115" width="700" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="lane-db" value="POSTGRESQL (InitialSchema1784870400000)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontSize=17;fontStyle=1;fontColor=#7c2d12;align=center;" vertex="1" parent="1">
          <mxGeometry x="1500" y="115" width="760" height="52" as="geometry"/>
