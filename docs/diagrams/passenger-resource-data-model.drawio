  <diagram id="passenger-resource-data-model" name="DTO · Entity · Database Mapping">
    <mxGraphModel dx="2300" dy="1940" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1940" math="0" shadow="0">
