        <mxCell id="title" value="Passenger Resource Management — DTO, Entity &amp;amp; Database Mapping" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1600" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="NestJS validation → application policy → TypeORM persistence → PostgreSQL schema" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="65" width="1400" height="30" as="geometry"/>
